# Copiez en .env (chmod 600). Fichier secret : ne pas versionner.

# Nom de domaine qui pointe vers ce serveur (certificat HTTPS automatique).
COCON_DOMAIN=cocon.exemple.org

# Mots de passe PostgreSQL : lettres et chiffres seulement (ils vont dans une
# URL). Générez-les avec : openssl rand -hex 24
POSTGRES_PASSWORD=
COCON_DB_PASSWORD=

# Inscriptions depuis l'interface web : open | invite | closed
COCON_API_SIGNUP=invite

# Envoi des invitations par e-mail (SMTP Hostinger de contact@tkcb.pro), facultatif :
#   docker compose exec cocon-api cocon-api invite --email ami@exemple.org
# Port 465 = TLS direct, 587 = STARTTLS (COCON_SMTP_TLS=tls|starttls pour forcer).
# Identifiant par défaut : l'adresse de COCON_MAIL_FROM.
COCON_MAIL_FROM=Cocon <contact@tkcb.pro>
COCON_SMTP_HOST=smtp.hostinger.com
COCON_SMTP_PORT=465
COCON_SMTP_USER=
# Mot de passe de la boîte contact@tkcb.pro (hPanel → E-mails).
COCON_SMTP_PASSWORD=
