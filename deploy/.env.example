# Copiez en .env (chmod 600). Fichier secret : ne pas versionner.

# Nom de domaine qui pointe vers ce serveur (certificat HTTPS automatique).
COCON_DOMAIN=cocon.exemple.org

# Mots de passe PostgreSQL : lettres et chiffres seulement (ils vont dans une
# URL). Générez-les avec : openssl rand -hex 24
POSTGRES_PASSWORD=
COCON_DB_PASSWORD=

# Inscriptions depuis l'interface web : open | invite | closed
COCON_API_SIGNUP=invite
